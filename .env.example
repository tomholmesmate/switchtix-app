# Copy these into Vercel: Project > Settings > Environment Variables.
# (Only needed in a .env.local file if you ever run the app on your own PC.)

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "anon" / "publishable" key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / "secret" key. NEVER share this or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Your live site address (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=https://switchtix.vercel.app

# --- Blockchain (optional; leave blank until you deploy the contract) ---
# Private key of a TEST-ONLY MetaMask account that deployed the contract.
# Never put a key here that holds real money.
MINTER_PRIVATE_KEY=
STUB_CONTRACT_ADDRESS=
# Optional. Defaults to the free public Base Sepolia endpoint.
BASE_SEPOLIA_RPC_URL=

# --- Escrow (Stripe TEST mode only; the app refuses live keys) ---
STRIPE_SECRET_KEY=sk_test_...
# Emails allowed to open /admin and resolve disputes (comma-separated)
ADMIN_EMAILS=you@example.com
# Any long random string; Vercel Cron sends it to /api/cron/release
CRON_SECRET=

# --- Google sign-in turns on automatically once enabled in Supabase; set to off to hide it ---
# NEXT_PUBLIC_GOOGLE_SIGNIN=off

# --- Optional: email updates (Gmail + app password works for the beta) ---
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=SwitchTix <you@gmail.com>
